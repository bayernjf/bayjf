# Used only by the local Vite dev server proxy; not embedded in the browser.
API_DEV_SERVER="http://localhost:8787"

# Optional browser analytics. Leave blank to disable the corresponding provider.
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
VITE_CLARITY_PROJECT_ID="your-clarity-project-id"
VITE_TURNSTILE_SITE_KEY="your-turnstile-site-key"

# Hono/Vercel server variables. Copy this file to .env.local for local API work.
ALLOWED_ORIGINS="http://localhost:3000"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
TURNSTILE_SECRET_KEY="YOUR_TURNSTILE_SECRET_KEY"

# Admin panel (/admin). Password is stored as a PBKDF2-SHA256 hash, never plaintext.
# Generate a hash with the bundled Node:
#   node -e "const c=crypto;(async()=>{const p='YOUR_PASSWORD';const s=c.getRandomValues(new Uint8Array(16));const k=await c.subtle.importKey('raw',new TextEncoder().encode(p),{name:'PBKDF2'},false,['deriveBits']);const b=new Uint8Array(await c.subtle.deriveBits({name:'PBKDF2',salt:s,iterations:100000,hash:'SHA-256'},k,256));console.log('pbkdf2-sha256$100000$'+Buffer.from(s).toString('base64')+'$'+Buffer.from(b).toString('base64'))})()"
ADMIN_USERNAME="bayjf"
ADMIN_PASSWORD_HASH="pbkdf2-sha256$100000$<salt>$<hash>"
ADMIN_SESSION_SECRET="<generate-a-long-random-secret>"
