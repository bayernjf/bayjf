---
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = 'en';
---

<BaseLayout
  lang={lang}
  screen="home"
  pathOverride="/404"
  seoTitle="404: Page Not Found | BayJF"
  seoDescription="The page you visited does not exist or has been moved."
>
  <main class="flex min-h-[70vh] flex-col items-center justify-center px-6 text-center">
    <p class="font-serif text-7xl font-bold text-sage dark:text-mint">404</p>
    <h1 class="mt-4 font-serif text-2xl font-semibold">Page Not Found</h1>
    <p class="mt-2 text-sm text-ink-soft dark:text-mist">
      The page you visited does not exist or has been moved.
    </p>
    <div class="mt-8 flex items-center gap-4">
      <a
        href="/"
        class="interactive rounded-full bg-sage px-6 py-3 text-sm font-semibold text-paper transition-all duration-300 hover:scale-105"
      >
        Back to Home
      </a>
      <a
        href="/zh"
        class="interactive rounded-full border border-hairline/60 dark:border-white/10 px-6 py-3 text-sm font-semibold text-ink-soft dark:text-mist transition-all duration-300 hover:scale-105"
      >
        中文首页
      </a>
    </div>
  </main>
</BaseLayout>
