---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteIsland from '../components/SiteIsland';
import type { Language, ScreenKey } from '../i18n/routing';

const lang = (Astro.currentLocale as Language) || 'en';
const screen: ScreenKey = 'bayjf';
---

<BaseLayout lang={lang} screen={screen}>
  <SiteIsland lang={lang} screen={screen} client:load />
</BaseLayout>
